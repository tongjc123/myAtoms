# Local development. scripts/setup-database.ps1 creates random credentials in ignored .env.
ATOMS_DB_URL=jdbc:mysql://127.0.0.1:3310/atoms_demo_dev?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
ATOMS_DB_USER=atoms_demo_app
ATOMS_DB_PASSWORD=replace-with-local-password
ATOMS_TEST_DB_URL=jdbc:mysql://127.0.0.1:3310/atoms_demo_test?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
ATOMS_TEST_DB_USER=atoms_demo_test
ATOMS_TEST_DB_PASSWORD=replace-with-separate-test-password
ATOMS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# Local HTTP only. Production defaults to true; configure exact HTTPS origins.
ATOMS_COOKIE_SECURE=false

# Volcengine Ark (Doubao Seedance) video provider. Server-side only: never expose this key to the
# browser, generated projects, exports or logs. The model must be activated for the account in the
# Ark console first; GET /api/system/provider reports whether it is usable right now.
ATOMS_ARK_API_KEY=
ATOMS_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Doubao Seedance model ID, e.g. doubao-seedance-2-0-260128 (4-15s, 480p/720p/1080p/4k),
# doubao-seedance-2-0-fast-260128 or doubao-seedance-2-5-260628. Leave empty to keep generation off.
ATOMS_ARK_VIDEO_MODEL=
# Optional extra catalog slots shown in the model menu. Leave empty until the account has them.
ATOMS_ARK_VIDEO_MODEL_25=
ATOMS_ARK_VIDEO_MODEL_WAN=
ATOMS_ARK_CONNECT_TIMEOUT=5s
ATOMS_ARK_REQUEST_TIMEOUT=30s

# Text model behind the web generation pipeline (Qianwen gateway, DashScope-style). Two paid calls
# per page: one plans the structure, one writes the single HTML file. Leave empty to keep web
# generation off; GET /api/system/provider reports whether the configured model is really usable.
# e.g. qwen-plus, qwen-max, qwen3.7-max. Server-side only, never expose this key to the browser.
ATOMS_QWEN_API_KEY=
ATOMS_QWEN_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
ATOMS_QWEN_TEXT_MODEL=
# Optional display name shown in the UI; falls back to the model id.
ATOMS_QWEN_TEXT_MODEL_NAME=
# Image model that paints the hero picture inlined into generated pages (Qwen-Image-3.0).
ATOMS_QWEN_IMAGE_MODEL=qwen-image-3.0
# Writing a page or painting an image takes longer than a plain call; keep these above request-timeout.
ATOMS_QWEN_TEXT_TIMEOUT=120s
ATOMS_QWEN_IMAGE_TIMEOUT=120s
ATOMS_QWEN_CONNECT_TIMEOUT=5s
ATOMS_QWEN_REQUEST_TIMEOUT=30s
# Only for local stubs: allow the provider to return loopback/private media URLs. Keep false.
ATOMS_QWEN_ALLOW_PRIVATE_MEDIA=false
# How long a run waits for the asynchronous task, and how often it polls the provider.
ATOMS_ARK_VIDEO_TIMEOUT=10m
ATOMS_ARK_POLL_INTERVAL=3s
# Only for local stubs: allow the provider to return loopback/private media URLs. Keep false.
ATOMS_ARK_ALLOW_PRIVATE_MEDIA=false
# Video spec defaults required by the product document: 5 seconds, 720P, one result per request.
ATOMS_VIDEO_DURATION=5
ATOMS_VIDEO_RESOLUTION=720p
ATOMS_VIDEO_RATIO=16:9
ATOMS_VIDEO_AUDIO=false
# Deployment-wide model budget in CNY, shared by every anonymous visitor and reserved before each
# paid call. Server hosting and domains are not part of this budget.
ATOMS_BUDGET_LIMIT_CNY=300
# Per-video reservation. After submission, failures/cancellation retain this amount until billing
# is reconciled. Fixed reservations are not verified provider prices or proof of a cash-spend cap.
ATOMS_VIDEO_RESERVE_CNY=6.00
# Per-run allowance for web/game generation and edits; include all text/image calls in your quote.
ATOMS_TEXT_RESERVE_CNY=1.00

# Lifetime of the opaque token used by the sandboxed preview of a cloned project.
ATOMS_PREVIEW_TTL=PT30M
