# Docker deployment environment. Copy to `.env.docker` and fill in real values.
#   cp .env.docker.example .env.docker
# `docker compose` auto-loads `.env` (or pass --env-file .env.docker). Never commit the real file.

# ---- MySQL (created by the mysql service on first start) ----
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=atoms_demo
MYSQL_USER=atoms
MYSQL_PASSWORD=change-this-app-password

# Public HTTP port for the web (Nginx) service. Change if 80 is taken by another
# site on the host (e.g. 宝塔 already serves PowerHub on 80).
WEB_PORT=8081

# JDBC URL used by the API container. `mysql` is the compose service name.
ATOMS_DB_URL=jdbc:mysql://mysql:3306/atoms_demo?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8

# ---- Web origin / cookie ----
# Comma-separated origins the browser may send requests from. For IP-only HTTP:
#   ATOMS_ALLOWED_ORIGINS=http://<your-server-ip>
# (browsers send an Origin only on cross-origin POST/SSE; same-origin via nginx sends none,
#  so this matters mostly when the front-end origin differs from the API origin.)
ATOMS_ALLOWED_ORIGINS=http://127.0.0.1
# false for plain HTTP; set true once HTTPS is in front.
ATOMS_COOKIE_SECURE=false

# ---- Model keys (server-side only) ----
# Volcengine Ark (video)
ATOMS_ARK_API_KEY=
ATOMS_ARK_VIDEO_MODEL=
# Qianwen (text + image for web/game generation)
ATOMS_QWEN_API_KEY=
ATOMS_QWEN_TEXT_MODEL=
ATOMS_QWEN_TEXT_MODEL_NAME=
ATOMS_QWEN_IMAGE_MODEL=qwen-image-3.0

# ---- Budget (shared across all anonymous visitors) ----
ATOMS_BUDGET_LIMIT_CNY=300.00
ATOMS_VIDEO_RESERVE_CNY=6.00
ATOMS_TEXT_RESERVE_CNY=1.00
